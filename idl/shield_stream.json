        { "name": "zk_proof", "type": "bytes" },
        { "name": "public_inputs", "type": { "vec": { "array": ["u8", 32] } } }
      ]
    },
    {
      "name": "set_stream_status",
      "accounts": [
        { "name": "stream", "isMut": true, "isSigner": false },
